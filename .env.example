# Copy to .env.local and fill in your own key. Never commit the real key.
GEMINI_API_KEY=
GEMINI_MODEL=gemini-3.5-flash

# Set all three to enable Supabase database mode. Keep the secret key server-only.
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=
SUPABASE_SECRET_KEY=

# Personal Google Drive: server-only OAuth credentials with the drive.file scope.
# Run `node --env-file=.env.local scripts/connect-google-drive.mjs` once to obtain a refresh token.
GOOGLE_DRIVE_CLIENT_ID=
GOOGLE_DRIVE_CLIENT_SECRET=
GOOGLE_DRIVE_REFRESH_TOKEN=

# Production AI review remains disabled unless deliberately enabled.
# A public demo needs authentication and request limits before enabling this.
AI_REVIEW_PUBLIC_DEMO=false
